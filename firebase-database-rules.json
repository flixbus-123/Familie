{
  "rules": {
    ".read": false,
    ".write": false,
    "userProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "familyAdmins": {
      "main": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && !root.child('familyAdmins/main').hasChildren()) || root.child('familyAdmins/main').child(auth.uid).val() === true)"
        }
      }
    },
    "familyBans": {
      "main": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('familyAdmins/main').child(auth.uid).val() === true"
        }
      }
    },
    "familyMembers": {
      "main": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('familyAdmins/main').child(auth.uid).val() === true)"
        }
      }
    },
    "families": {
      "main": {
        ".read": "auth != null && root.child('familyMembers/main').child(auth.uid).exists() && !root.child('familyBans/main').child(auth.uid).exists()",
        ".write": "auth != null && root.child('familyMembers/main').child(auth.uid).exists() && !root.child('familyBans/main').child(auth.uid).exists()"
      }
    }
  }
}