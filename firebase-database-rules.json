{
  "rules": {
    ".read": false,
    ".write": false,
    "userProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "familyMembers": {
      "main": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "families": {
      "main": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}